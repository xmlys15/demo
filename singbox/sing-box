cat << 'EOF' > /etc/init.d/sing-box
#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG="/usr/bin/sing-box"
CONF="/etc/sing-box/config.json"
WORK_DIR="/var/run/sing-box"

start_service() {
    [ -f "$CONF" ] || {
        echo "Configuration file $CONF not found!"
        return 1
    }

    mkdir -p "$WORK_DIR"

    # 启动前校验（带上工作目录校验）
    $PROG check -c "$CONF" -D "$WORK_DIR" >/dev/null 2>&1 || {
        echo "sing-box config check failed!"
        return 1
    }

    procd_open_instance "sing-box"
    # 关键点 1：procd 进程工作目录
    procd_set_param dir "$WORK_DIR"
    # 关键点 2：sing-box 自身的工作目录参数 -D
    procd_set_param command "$PROG" run -c "$CONF" -D "$WORK_DIR"
    procd_set_param respawn 3600 5 0
    procd_set_param limits core="unlimited"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    procd_send_signal "sing-box"
}

reload_service() {
    procd_send_signal "sing-box" "" HUP
}
EOF

chmod +x /etc/init.d/sing-box