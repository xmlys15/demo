{
    "$schema": "https://sing-box.sagernet.org/schema.json",
    "log": {
        "level": "warn",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "local",
                "type": "udp",
                "server": "192.168.2.1"
            },
            {
                "tag": "google",
                "type": "https",
                "server": "dns.google",
                "domain_resolver": "hosts",
                "detour": "proxy"
            },
            {
                "tag": "hosts",
                "type": "hosts",
                "predefined": {
                    "dns.google": [
                        "8.8.8.8",
                        "8.8.4.4"
                    ]
                }
            },
            {
                "tag": "fakeip",
                "type": "fakeip",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "fc00::/18"
            }
        ],
        "rules": [
            {
                "domain_suffix": "lan",
                "server": "local"
            },
            {
                "clash_mode": "Direct",
                "server": "local"
            },
            {
                "clash_mode": "Global",
                "server": "fakeip"
            },
            {
                "query_type": "HTTPS",
                "action": "reject"
            },
            {
                "rule_set": [
                    "geosite-direct",
                    "geosite-oracle",
                    "geosite-amazon@cn",
                    "geosite-apple@cn",
                    "geosite-cn"
                ],
                "server": "local"
            },
            {
                "query_type": [
                    "A",
                    "AAAA"
                ],
                "server": "fakeip"
            }
        ],
        "final": "google",
        "optimistic": true
    },
    "outbounds": [
        {
            "tag": "direct",
            "type": "direct"
        },
        {
            "tag": "proxy",
            "type": "selector",
            "outbounds": [
                "direct"
            ]
        }
    ],
    "inbounds": [
        {
            "type": "tun",
            "address": [
                "172.18.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "stack": "system",
            "mtu": 9000,
            "auto_route": true,
            "auto_redirect": true,
            "strict_route": true,
            "route_exclude_address_set": "geoip-cn",
            "dns_mode": "hijack"
        },
        {
            "type": "mixed",
            "listen": "::",
            "listen_port": 7890
        }
    ],
    "route": {
        "rules": [
            {
                "action": "sniff"
            },
            {
                "ip_is_private": true,
                "outbound": "direct"
            },
            {
                "clash_mode": "Direct",
                "outbound": "direct"
            },
            {
                "clash_mode": "Global",
                "outbound": "proxy"
            },
            {
                "port": [
                    3478,
                    5201
                ],
                "outbound": "direct"
            },
            {
                "protocol": "ssh",
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "geosite-direct",
                    "geosite-oracle",
                    "geosite-amazon@cn",
                    "geosite-apple@cn",
                    "geosite-cn"
                ],
                "outbound": "direct"
            }
        ],
        "rule_set": [
            {
                "tag": "geosite-direct",
                "type": "inline",
                "rules": [
                    {
                        "domain_suffix": [
                            "656525.xyz",
                            "501388.xyz",
                            "665080.xyz",
                            "xmlys.de",
                            "edu101.com",
                            "nino.nyc.mn",
                            "wud.de5.net",
                            "zyz.hidns.co"
                        ],
                        "domain_keyword": [
                            "netcup"
                        ]
                    }
                ]
            },
            {
                "tag": [
                    "geosite-cn",
                    "geosite-apple@cn",
                    "geosite-oracle",
                    "geosite-amazon@cn"
                ],
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs"
            },
            {
                "tag": "geoip-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/{tag}.srs"
            }
        ],
        "default_domain_resolver": "local",
        "default_http_client": "direct_client",
        "auto_detect_interface": true,
        "final": "proxy"
    },
    "services": [
        {
            "type": "api",
            "listen": "::",
            "listen_port": 9090,
            "secret": "",
            "dashboard": {
                "enabled": true,
                "download_url": "https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
                "http_client": "proxy_client"
            }
        }
    ],
    "http_clients": [
        {
            "tag": "direct_client"
        },
        {
            "tag": "proxy_client",
            "detour": "proxy"
        }
    ],
    "experimental": {
        "cache_file": {
            "enabled": true,
            "store_fakeip": true,
            "store_dns": true
        }
    }
}