{
    "log": {
        "level": "warn",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "local",
                "type": "local"
            },
            {
                "tag": "google",
                "type": "https",
                "server": "dns.google",
                "domain_resolver": "hosts",
                "detour": "proxy"
            },
            {
                "tag": "hosts",
                "type": "hosts",
                "predefined": {
                    "dns.google": [
                        "8.8.8.8",
                        "8.8.4.4"
                    ]
                }
            },
            {
                "tag": "fakeip",
                "type": "fakeip",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "fc00::/18"
            }
        ],
        "rules": [
            {
                "query_type": [
                    "HTTPS",
                    "SVCB"
                ],
                "action": "predefined",
                "rcode": "NOERROR"
            },
            {
                "rule_set": [
                    "geosite-direct",
                    "geosite-oracle",
                    "geosite-amazon@cn",
                    "geosite-apple@cn",
                    "geosite-cn"
                ],
                "server": "local"
            },
            {
                "query_type": [
                    "A",
                    "AAAA"
                ],
                "server": "fakeip"
            }
        ],
        "final": "google",
        "optimistic": true
    },
    "outbounds": [
        {
            "tag": "direct",
            "type": "direct"
        },
        {
            "tag": "proxy",
            "type": "selector",
            "outbounds": []
        }
    ],
    "inbounds": [
        {
            "type": "tun",
            "address": [
                "172.18.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "stack": "system",
            "auto_route": true,
            "route_exclude_address_set": "geoip-cn",
            "dns_mode": "hijack"
        }
    ],
    "route": {
        "rules": [
            {
                "action": "sniff"
            },
            {
                "protocol": "dns",
                "action": "hijack-dns"
            },
            {
                "port": 5223,
                "outbound": "direct"
            },
            {
                "protocol": "ssh",
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "geosite-direct",
                    "geosite-oracle",
                    "geosite-amazon@cn",
                    "geosite-apple@cn",
                    "geosite-cn"
                ],
                "outbound": "direct"
            }
        ],
        "rule_set": [
            {
                "tag": "geosite-direct",
                "type": "inline",
                "rules": [
                    {
                        "domain_suffix": [
                            "656525.xyz",
                            "501388.xyz",
                            "665080.xyz",
                            "xmlys.de",
                            "edu101.com",
                            "nino.nyc.mn",
                            "wud.de5.net",
                            "zyz.hidns.co"
                        ],
                        "domain_keyword": [
                            "netcup"
                        ]
                    }
                ]
            },
            {
                "tag": [
                    "geosite-cn",
                    "geosite-apple@cn",
                    "geosite-oracle",
                    "geosite-amazon@cn"
                ],
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs"
            },
            {
                "tag": "geoip-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/{tag}.srs"
            }
        ],
        "default_domain_resolver": "local",
        "default_http_client": "direct_client",
        "auto_detect_interface": true,
        "final": "proxy"
    },
    "http_clients": [
        {
            "tag": "direct_client"
        }
    ],
    "experimental": {
        "cache_file": {
            "enabled": true,
            "store_fakeip": true,
            "store_dns": true
        }
    }
}