{
    "dns": {
        "servers": [
            {
                "tag": "local",
                "type": "local",
                "prefer_go": true
            },
            {
                "tag": "google",
                "type": "https",
                "server": "8.8.8.8",
                "detour": "proxy"
            },
            {
                "tag": "alidns",
                "type": "https",
                "server": "223.5.5.5"
            },
            {
                "tag": "fakeip",
                "type": "fakeip",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "fc00::/18"
            }
        ],
        "rules": [
            {
                "query_type": [
                    "HTTPS",
                    "SVCB"
                ],
                "action": "predefined",
                "rcode": "NOERROR"
            },
            {
                "rule_set": [
                    "geosite-category-ai-!cn",
                    "geosite-google",
                    "geosite-github",
                    "geosite-geolocation-!cn"
                ],
                "server": "fakeip"
            },
            {
                "rule_set": [
                    "geosite-direct",
                    "geosite-douyin",
                    "geosite-oracle",
                    "geosite-amazon@cn",
                    "geosite-apple@cn",
                    "geosite-apple-update",
                    "geosite-microsoft@cn",
                    "geosite-cn"
                ],
                "server": "local"
            },
            {
                "type": "logical",
                "mode": "and",
                "rules": [
                    {
                        "query_type": [
                            "A",
                            "AAAA"
                        ]
                    },
                    {
                        "rule_set": "geosite-geolocation-!cn",
                        "invert": true
                    }
                ],
                "action": "evaluate",
                "server": "google",
                "client_subnet": "223.5.5.0/24",
                "timeout": "2s"
            },
            {
                "match_response": true,
                "rule_set": "geoip-cn",
                "server": "alidns"
            },
            {
                "query_type": [
                    "A",
                    "AAAA"
                ],
                "server": "fakeip"
            }
        ],
        "final": "google",
        "reverse_mapping": true,
        "optimistic": true
    },
    "outbounds": [
        {
            "tag": "direct",
            "type": "direct"
        },
        {
            "tag": "proxy",
            "type": "selector",
            "outbounds": []
        }
    ],
    "inbounds": [
        {
            "type": "tun",
            "address": [
                "172.31.255.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "auto_route": true,
            "route_exclude_address_set": "geoip-cn",
            "dns_mode": "hijack"
        }
    ],
    "route": {
        "rules": [
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "domain_suffix": "push.apple.com"
                    },
                    {
                        "rule_set": "geoip-telegram"
                    }
                ],
                "invert": true,
                "action": "sniff"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "protocol": "dns"
                    },
                    {
                        "port": 53
                    }
                ],
                "action": "hijack-dns"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "port": 853
                    },
                    {
                        "protocol": [
                            "stun",
                            "quic"
                        ]
                    }
                ],
                "action": "reject",
                "no_drop": true
            },
            {
                "network": "icmp",
                "action": "resolve"
            },
            {
                "network": "icmp",
                "outbound": "direct"
            },
            {
                "ip_is_private": true,
                "outbound": "direct"
            },
            {
                "port": 5223,
                "outbound": "direct"
            },
            {
                "protocol": [
                    "ssh",
                    "bittorrent"
                ],
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "geosite-category-ai-!cn",
                    "geosite-google",
                    "geosite-github"
                ],
                "outbound": "proxy"
            },
            {
                "rule_set": [
                    "geosite-direct",
                    "geosite-douyin",
                    "geosite-oracle",
                    "geosite-amazon@cn",
                    "geosite-apple@cn",
                    "geosite-apple-update",
                    "geosite-microsoft@cn",
                    "geosite-cn"
                ],
                "outbound": "direct"
            }
        ],
        "rule_set": [
            {
                "tag": "geosite-direct",
                "type": "inline",
                "rules": [
                    {
                        "domain_suffix": [
                            "656525.xyz",
                            "501388.xyz",
                            "665080.xyz",
                            "xmlys.de",
                            "edu101.com",
                            "nino.nyc.mn",
                            "wud.de5.net",
                            "zyz.hidns.co",
                            "pool.ntp.org",
                            "time.apple.com",
                            "time.windows.com"
                        ],
                        "domain_keyword": [
                            "netcup",
                            "ntp"
                        ]
                    }
                ]
            },
            {
                "tag": [
                    "geosite-category-ai-!cn",
                    "geosite-google",
                    "geosite-github",
                    "geosite-geolocation-!cn",
                    "geosite-cn",
                    "geosite-douyin",
                    "geosite-oracle",
                    "geosite-amazon@cn",
                    "geosite-apple@cn",
                    "geosite-apple-update",
                    "geosite-microsoft@cn"
                ],
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs"
            },
            {
                "tag": "geoip-telegram",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/telegram.srs"
            },
            {
                "tag": "geoip-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/{tag}.srs"
            }
        ],
        "default_domain_resolver": "local",
        "auto_detect_interface": true,
        "final": "proxy"
    },
    "experimental": {
        "cache_file": {
            "enabled": true,
            "store_fakeip": true,
            "store_dns": true
        }
    },
    "http_clients": [
        {
            "tag": "direct_client"
        }
    ],
    "log": {
        "level": "warn",
        "timestamp": true
    }
}