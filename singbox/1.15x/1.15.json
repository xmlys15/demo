{
    "$schema": "https://sing-box.sagernet.org/schema.json",
    "dns": {
        "servers": [
            {
                "tag": "local",
                "type": "udp",
                "server": "192.168.2.1"
            },
            {
                "tag": "google",
                "type": "https",
                "server": "dns.google",
                "domain_resolver": "hosts",
                "detour": "proxy"
            },
            {
                "tag": "hosts",
                "type": "hosts",
                "predefined": {
                    "dns.google": [
                        "8.8.8.8",
                        "8.8.4.4"
                    ]
                }
            },
            {
                "tag": "fakeip",
                "type": "fakeip",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "fc00::/18"
            }
        ],
        "rules": [
            {
                "query_type": [
                    "HTTPS",
                    "SVCB"
                ],
                "action": "predefined",
                "rcode": "NOERROR"
            },
            {
                "clash_mode": "Direct",
                "server": "local"
            },
            {
                "clash_mode": "Global",
                "server": "fakeip"
            },
            {
                "domain_suffix": [
                    "lan",
                    "local",
                    "arpa"
                ],
                "server": "local"
            },
            {
                "rule_set": [
                    "geosite-direct",
                    "geosite-douyin",
                    "geosite-oracle",
                    "geosite-amazon@cn",
                    "geosite-apple@cn",
                    "geosite-apple-update",
                    "geosite-microsoft@cn",
                    "geosite-steam@cn",
                    "geosite-cn"
                ],
                "server": "local"
            },
            {
                "rule_set": [
                    "geosite-category-ai-!cn",
                    "geosite-github",
                    "geosite-google",
                    "geosite-geolocation-!cn"
                ],
                "server": "fakeip"
            },
            {
                "type": "logical",
                "mode": "and",
                "rules": [
                    {
                        "query_type": [
                            "A",
                            "AAAA"
                        ]
                    },
                    {
                        "rule_set": "geosite-geolocation-!cn",
                        "invert": true
                    }
                ],
                "action": "evaluate",
                "server": "google",
                "client_subnet": "223.5.5.0/24",
                "timeout": "2s"
            },
            {
                "match_response": true,
                "rule_set": "geoip-cn",
                "server": "local"
            },
            {
                "query_type": [
                    "A",
                    "AAAA"
                ],
                "server": "fakeip"
            }
        ],
        "final": "google",
        "reverse_mapping": true,
        "optimistic": true
    },
    "outbounds": [
        {
            "tag": "direct",
            "type": "direct"
        },
        {
            "tag": "proxy",
            "type": "selector",
            "outbounds": []
        }
    ],
    "inbounds": [
        {
            "type": "tun",
            "address": [
                "172.31.255.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "mtu": 9000,
            "auto_route": true,
            "auto_redirect": true,
            "strict_route": true,
            "exclude_mptcp": true,
            "route_exclude_address": [
                "69.63.206.12/32",
                "179.253.246.97/32",
                "168.138.188.147/32",
                "161.118.206.153/32",
                "113.20.13.224/32",
                "51.81.187.116/32",
                "35.212.128.85/32",
                "2603:c024:4514:9b20:34:1fe2:f727:89e0/128",
                "2603:c024:4514:9b20:0:be4f:9f1a:6a03/128",
                "2607:f130:0:167::9211:6d57/128",
                "2604:2dc0:202:300::7f9/128"
            ],
            "dns_mode": "hijack"
        },
        {
            "tag": "mixed",
            "type": "mixed",
            "listen": "::",
            "listen_port": 7890
        }
    ],
    "route": {
        "rules": [
            {
                "type": "logical",
                "mode": "and",
                "rules": [
                    {
                        "port": [
                            53,
                            853
                        ],
                        "invert": true
                    },
                    {
                        "clash_mode": "Global",
                        "invert": true
                    },
                    {
                        "type": "logical",
                        "mode": "or",
                        "rules": [
                            {
                                "ip_is_private": true
                            },
                            {
                                "rule_set": "geoip-cn"
                            }
                        ]
                    }
                ],
                "action": "bypass"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "domain_suffix": "push.apple.com"
                    },
                    {
                        "rule_set": "geoip-telegram"
                    }
                ],
                "invert": true,
                "action": "sniff"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "port": 53
                    },
                    {
                        "protocol": "dns"
                    }
                ],
                "action": "hijack-dns"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "port": 853
                    },
                    {
                        "protocol": [
                            "stun",
                            "quic"
                        ]
                    }
                ],
                "action": "reject",
                "no_drop": true
            },
            {
                "network": "icmp",
                "action": "resolve"
            },
            {
                "network": "icmp",
                "outbound": "direct"
            },
            {
                "ip_is_private": true,
                "outbound": "direct"
            },
            {
                "protocol": [
                    "bittorrent"
                ],
                "outbound": "direct"
            },
            {
                "clash_mode": "Direct",
                "outbound": "direct"
            },
            {
                "clash_mode": "Global",
                "outbound": "proxy"
            },
            {
                "rule_set": [
                    "geosite-direct"
                ],
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "geosite-category-ai-!cn",
                    "geosite-google",
                    "geosite-github"
                ],
                "outbound": "proxy"
            },
            {
                "rule_set": [
                    "geosite-douyin",
                    "geosite-oracle",
                    "geosite-amazon@cn",
                    "geosite-apple@cn",
                    "geosite-apple-update",
                    "geosite-microsoft@cn",
                    "geosite-steam@cn",
                    "geosite-cn"
                ],
                "outbound": "direct"
            },
            {
                "inbound": "mixed",
                "action": "resolve"
            },
            {
                "rule_set": [
                    "geoip-telegram"
                ],
                "outbound": "proxy"
            },
            {
                "rule_set": [
                    "geoip-cn"
                ],
                "outbound": "direct"
            }
        ],
        "rule_set": [
            {
                "tag": "geosite-direct",
                "type": "inline",
                "rules": [
                    {
                        "domain_suffix": [
                            "656525.xyz",
                            "501388.xyz",
                            "665080.xyz",
                            "xmlys.de",
                            "edu101.com",
                            "nino.nyc.mn",
                            "wud.de5.net",
                            "zyz.hidns.co",
                            "pool.ntp.org",
                            "time.apple.com",
                            "time.windows.com"
                        ],
                        "domain_keyword": [
                            "netcup",
                            "ntp"
                        ]
                    }
                ]
            },
            {
                "tag": [
                    "geosite-category-ai-!cn",
                    "geosite-google",
                    "geosite-github",
                    "geosite-geolocation-!cn",
                    "geosite-cn",
                    "geosite-douyin",
                    "geosite-oracle",
                    "geosite-amazon@cn",
                    "geosite-apple@cn",
                    "geosite-apple-update",
                    "geosite-microsoft@cn",
                    "geosite-steam@cn"
                ],
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/{tag}.srs"
            },
            {
                "tag": "geoip-telegram",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/telegram.srs"
            },
            {
                "tag": "geoip-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/{tag}.srs"
            }
        ],
        "default_domain_resolver": "local",
        "default_http_client": "direct_client",
        "auto_detect_interface": true,
        "final": "proxy"
    },
    "services": [
        {
            "type": "api",
            "listen": "::",
            "listen_port": 9090,
            "secret": "",
            "dashboard": {
                "enabled": true,
                "download_url": "https://proxy.501388.xyz/https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip"
            }
        }
    ],
    "experimental": {
        "cache_file": {
            "enabled": true,
            "store_fakeip": true,
            "store_dns": true
        }
    },
    "certificate": {
        "store": "chrome"
    },
    "ntp": {
        "enabled": true,
        "server": "time.apple.com"
    },
    "http_clients": [
        {
            "tag": "direct_client"
        }
    ],
    "log": {
        "level": "warn",
        "timestamp": true
    }
}